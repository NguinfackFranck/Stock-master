<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_l"
    android:layout_marginBottom="@dimen/space_m"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:padding="@dimen/space_l">

    <View
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="@dimen/space_m"
        android:background="@drawable/shape_dot"
        android:backgroundTint="@color/status_low" />

    <TextView
        android:id="@+id/text_low_stock_name"
        style="@style/Text.Display.Small"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        tools:text="Bag of Cement" />

    <TextView
        android:id="@+id/text_low_stock_detail"
        style="@style/Text.Mono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/status_low"
        tools:text="4 / 5" />

</LinearLayout>
