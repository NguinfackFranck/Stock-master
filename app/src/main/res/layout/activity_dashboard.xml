<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_xl">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/surface"
            android:paddingHorizontal="@dimen/space_l"
            android:paddingTop="@dimen/space_xl"
            android:paddingBottom="@dimen/space_l"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/eyebrow_overview" />

                <TextView
                    style="@style/Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="26sp"
                    android:text="@string/screen_title_dashboard" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_settings"
                android:contentDescription="Settings"
                app:tint="@color/text_secondary"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline_width"
            android:background="@color/hairline" />

        <!-- Hero stat cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_l"
            android:paddingTop="@dimen/space_l">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_s"
                android:orientation="vertical"
                android:background="@drawable/bg_stat_card"
                android:padding="@dimen/space_l">

                <TextView
                    style="@style/Text.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#9FB0AA"
                    android:text="@string/stat_label_total_stock_value" />

                <TextView
                    android:id="@+id/text_dashboard_stock_value"
                    style="@style/Text.Mono.Large"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:textColor="@color/surface"
                    tools:text="$4,820" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_s"
                android:orientation="vertical"
                android:background="@drawable/bg_stat_card_light"
                android:padding="@dimen/space_l">

                <TextView
                    style="@style/Text.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/brand_emerald_tint"
                    android:text="@string/stat_label_revenue_this_week" />

                <TextView
                    android:id="@+id/text_dashboard_revenue"
                    style="@style/Text.Mono.Large"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:textColor="@color/surface"
                    tools:text="$1,240" />
            </LinearLayout>

        </LinearLayout>

        <!-- Low stock summary -->
        <LinearLayout
            android:id="@+id/card_low_stock_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_l"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_banner_warning"
            android:padding="@dimen/space_l"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="@dimen/space_m"
                android:contentDescription="@string/content_desc_low_stock_icon"
                android:src="@drawable/ic_warning" />

            <TextView
                android:id="@+id/text_dashboard_low_stock"
                style="@style/Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/status_low"
                tools:text="3 products need reordering" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right" />

        </LinearLayout>

        <!-- Quick nav -->
        <TextView
            style="@style/Text.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginBottom="@dimen/space_s"
            android:text="@string/eyebrow_quick_actions" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_l">

            <include
                android:id="@+id/nav_products"
                layout="@layout/item_nav_card" />

            <View android:layout_width="@dimen/space_m" android:layout_height="1dp" />

            <include
                android:id="@+id/nav_stock"
                layout="@layout/item_nav_card" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_l">

            <include
                android:id="@+id/nav_sale"
                layout="@layout/item_nav_card" />

            <View android:layout_width="@dimen/space_m" android:layout_height="1dp" />

            <include
                android:id="@+id/nav_report"
                layout="@layout/item_nav_card" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
